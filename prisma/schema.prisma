generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  groups        Group[]   @relation("UserGroups")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model Group {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  users        User[]        @relation("UserGroups")
  participants Participant[]
  receipts     Receipt[]
}

model Participant {
  id        String   @id @default(cuid())
  name      String
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receipts  Receipt[] // Receipts paid by this participant
  items     Item[]   // Items assigned to this participant

  @@unique([groupId, name])
}

model Receipt {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  totalAmount Float    @default(0)
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId     String?
  payer       Participant? @relation(fields: [payerId], references: [id], onDelete: SetNull)
  imageUrl    String?
  isSettled   Boolean @default(false)
  items       Item[]
}

model Item {
  id           String      @id @default(cuid())
  name         String
  price        Float
  category     String?
  receiptId    String
  receipt      Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  assignedToId String?     // If null, it's a "Shared" item
  assignedTo   Participant? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
